[
    {
        "name": "Finetune NoPtInit - AssetBERT",
        "description": "BERT direct finetune from random init on each quarter (no AssetBERT pretrain). Reuses timesplit_robust per-quarter AssetW2V .model as tokenizer/vocab source only. 7 dims x 16 quarters = 112 configs.",
        "template": {
            "model": {
                "model_type": "BERT",
                "model_checkpoint": null,
                "w2v_model": null,
                "embedding_file": null,
                "vocab_size": "{vocab_size}",
                "hidden_size": "{dim}",
                "num_hidden_layers": 4,
                "num_attention_heads": 2,
                "intermediate_size": "{intermediate_size}",
                "max_position_embeddings": "{max_position_embeddings}",
                "type_vocab_size": 1,
                "freeze_embedding": false,
                "freeze_encoder": false
            },
            "tokenizer": {
                "w2v_model": "checkpoints/timesplit_robust/finetune/AssetW2V/d{dim}/{quarter}/AssetW2V_d{dim}_{quarter}.model",
                "vocab_file": null,
                "pretrained_tokenizer_file": null,
                "alias_file": null
            },
            "dataset": {
                "data_path": "data/processed/MutualFundShareHoldings_TimeSplit/finetune/{quarter}.csv",
                "data_format": "csv",
                "id_key": "InvestorID",
                "portfolio_key": "Portfolio",
                "proportion1_key": "Proportion1",
                "proportion2_key": "Proportion2",
                "include_proportion": true,
                "max_length": "{max_position_embeddings}",
                "num_repeats": 1,
                "mask_prob": 0.15,
                "mask_indices": null,
                "cache_size": 80
            },
            "dataloader": {
                "batch_size": 32,
                "shuffle": true,
                "num_workers": 4,
                "persistent_workers": true,
                "pin_memory": true,
                "drop_last": false
            },
            "optimizer": {
                "optimizer_type": "PagedAdam8bit",
                "optimizer_kwargs": null,
                "learning_rate": 0.001,
                "lr_scheduler_type": "cosine",
                "lr_scheduler_warmup_steps": 0,
                "lr_scheduler_train_steps": null,
                "lr_scheduler_num_cycles": 0.5,
                "lr_scheduler_power": 0
            },
            "accelerator": {
                "mixed_precision": "auto",
                "gradient_accumulation_steps": 1,
                "accelerator_checkpoint": null,
                "use_compile": true,
                "compile_backend": "inductor",
                "compile_mode": "default",
                "compile_fullgraph": false,
                "compile_dynamic": false,
                "compile_cache_dir": null,
                "allow_tf32": true
            },
            "train": {
                "max_epoches": 30,
                "validation_split": null,
                "split_method": "random",
                "best_metric": "train_loss",
                "clip_grad_norm": 1.0,
                "clip_grad_value": null,
                "detect_anomaly": true,
                "check_per_step": 200,
                "report_per_epoch": 1,
                "save_per_epoch": 1,
                "save_folder": "checkpoints/pt_strategy_ablation/no_pt_init/finetune/AssetBERT/d{dim}/{quarter}",
                "save_name": "AssetBERT_no_pt_init_d{dim}_{quarter}",
                "save_format": ".safetensors",
                "seed": 42,
                "keep_best_only": true
            }
        },
        "output_dir": "configs/pt_strategy_ablation/no_pt_init/finetune/AssetBERT/d{dim}",
        "filename": "AssetBERT_no_pt_init_d{dim}_{quarter}.json",
        "variable_params": {
            "dim": [4, 8, 10, 16, 32, 64, 128],
            "intermediate_size": [512, 512, 512, 512, 512, 1024, 1024],
            "max_position_embeddings": [64, 64, 64, 64, 64, 256, 256],
            "quarter": [
                "2020Q4", "2021Q1", "2021Q2", "2021Q3", "2021Q4",
                "2022Q1", "2022Q2", "2022Q3", "2022Q4",
                "2023Q1", "2023Q2", "2023Q3", "2023Q4",
                "2024Q1", "2024Q2", "2024Q3"
            ],
            "vocab_size": [
                2794, 1420, 3024, 1625, 3479,
                1804, 3662, 1844, 4025,
                2127, 4543, 2324, 4960,
                2089, 4769, 1917
            ]
        },
        "variable_bindings": [
            {"dim": 4,   "intermediate_size": 512,  "max_position_embeddings": 64},
            {"dim": 8,   "intermediate_size": 512,  "max_position_embeddings": 64},
            {"dim": 10,  "intermediate_size": 512,  "max_position_embeddings": 64},
            {"dim": 16,  "intermediate_size": 512,  "max_position_embeddings": 64},
