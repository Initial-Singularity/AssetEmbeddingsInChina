            {"quarter": "2022Q2", "vocab_size": 3662},
            {"quarter": "2022Q3", "vocab_size": 1844},
            {"quarter": "2022Q4", "vocab_size": 4025},
            {"quarter": "2023Q1", "vocab_size": 2127},
            {"quarter": "2023Q2", "vocab_size": 4543},
            {"quarter": "2023Q3", "vocab_size": 2324},
            {"quarter": "2023Q4", "vocab_size": 4960},
            {"quarter": "2024Q1", "vocab_size": 2089},
