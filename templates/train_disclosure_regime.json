    {
        "name": "Disclosure Regime - BERT pretrain",
        "description": "BERT pretraining (validation-based selection, context 256 / FFN 512) on the regime's pretrained/ quarters, d{dim}, initialized from the chain's W2V. 63 configs.",
        "template": {
            "model": {
                "model_type": "BERT",
                "model_checkpoint": null,
                "w2v_model": "checkpoints/disclosure_regime/{level}/s{seed}/pretrained/AssetW2V/d{dim}/AssetW2V_d{dim}_pretrained.model",
                "embedding_file": null,
                "vocab_size": 5400,
                "hidden_size": "{dim}",
                "num_hidden_layers": 4,
                "num_attention_heads": 2,
                "intermediate_size": 512,
                "max_position_embeddings": 256,
                "type_vocab_size": 1,
                "freeze_embedding": false,
                "freeze_encoder": false
            },
            "tokenizer": {
                "w2v_model": "checkpoints/disclosure_regime/{level}/s{seed}/pretrained/AssetW2V/d{dim}/AssetW2V_d{dim}_pretrained.model",
                "vocab_file": null,
                "pretrained_tokenizer_file": null,
                "alias_file": null
            },
            "dataset": {
                "data_path": "data/processed/DisclosureRegime/{level}/pretrained",
                "data_format": "csv",
                "id_key": "InvestorID",
                "portfolio_key": "Portfolio",
                "proportion1_key": "Proportion1",
                "proportion2_key": "Proportion2",
                "include_proportion": false,
                "max_length": 256,
                "mask_prob": 0.15,
                "mask_indices": null
            },
            "dataloader": {
                "batch_size": 128,
                "shuffle": true,
                "num_workers": 4,
                "persistent_workers": true,
                "pin_memory": true,
                "drop_last": false
            },
            "optimizer": {
                "optimizer_type": "AdamW",
                "optimizer_kwargs": null,
                "learning_rate": 0.001,
                "lr_scheduler_type": "cosine",
                "lr_scheduler_warmup_steps": 500,
                "lr_scheduler_train_steps": null,
                "lr_scheduler_num_cycles": 0.5,
                "lr_scheduler_power": 0
            },
            "accelerator": {
                "mixed_precision": "auto",
                "gradient_accumulation_steps": 1,
                "accelerator_checkpoint": null,
                "use_compile": true,
                "compile_backend": "inductor",
                "compile_mode": "default",
                "compile_fullgraph": false,
                "compile_dynamic": false,
                "compile_cache_dir": null,
                "allow_tf32": true
            },
            "train": {
                "max_epochs": 40,
                "validation_split": 0.1,
                "split_method": "random",
                "best_metric": "val_loss",
                "clip_grad_norm": 1.0,
                "clip_grad_value": null,
                "detect_anomaly": false,
                "log_every_steps": 200,
                "report_every_epochs": 1,
                "calculate_contextualized_embeddings": false,
                "save_every_epochs": 1,
                "save_folder": "checkpoints/disclosure_regime/{level}/s{seed}/pretrained/AssetBERT/d{dim}",
                "save_name": "AssetBERT_d{dim}_pretrained",
                "save_format": ".safetensors",
                "seed": "{seed}",
                "keep_best_only": true,
                "early_stop_enabled": true,
                "early_stop_patience": 5,
                "early_stop_min_delta": 0.001,
                "early_stop_mode": "min",
                "early_stop_relative": true,
                "early_stop_metric": "val_loss"
            }
        },
