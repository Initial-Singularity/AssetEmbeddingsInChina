                "features": [
                    "industry"
                ]
            },
            {
                "_nonaligned": "",
                "_prefix": "Chars_IndustryDummy",
                "features": [
                    "chars",
                    "industry"
                ]
            },
            {
                "_nonaligned": "_nonaligned",
                "_prefix": "Chars_IndustryDummy",
                "features": [
                    "chars",
                    "industry"
                ]
            }
        ]
