[
    {
        "name": "RV Industry Eval - No Embedding (IndustryDummy / Chars+IndustryDummy)",
        "description": "Generates RV configs for industry-only and chars+industry variants, both aligned and non-aligned.",
        "template": {
            "model_type": "{_prefix}",
            "embedding_path": null,
            "benchmark_path": [
                "data/processed/Benchmark/2023Q2.csv",
                "data/processed/Benchmark/2023Q3.csv",
                "data/processed/Benchmark/2023Q4.csv",
                "data/processed/Benchmark/2024Q1.csv",
                "data/processed/Benchmark/2024Q2.csv",
                "data/processed/Benchmark/2024Q3.csv"
            ],
            "periods": [
                "2023Q2",
                "2023Q3",
                "2023Q4",
                "2024Q1",
                "2024Q2",
                "2024Q3"
            ],
            "embedding_token_col": "Token",
            "embedding_value_pattern": "Embed_*",
            "benchmark_stock_col": "Stkcd",
            "normalization": "standard",
            "features": "{features}",
            "align_chars": false,
            "ridge_alpha": 0.5,
            "seed": 42
        },
        "output_dir": "configs/industry/eval/RV/d{dim}",
        "filename": "{_prefix}_d{dim}{_nonaligned}.json",
        "variable_params": {
            "dim": [
                4,
                8,
                10,
                16,
                32,
                64,
                128
            ],
            "_prefix": [
                "IndustryDummy",
                "Chars_IndustryDummy"
            ],
            "_nonaligned": [
                "",
                "_nonaligned"
            ],
            "features": [
                [
                    "industry"
                ],
                [
                    "chars",
                    "industry"
                ]
            ]
        },
        "variable_bindings": [
            {
                "_nonaligned": "",
                "_prefix": "IndustryDummy",
                "features": [
                    "industry"
                ]
            },
            {
                "_nonaligned": "_nonaligned",
