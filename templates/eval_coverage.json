[
    {
        "name": "Coverage groups - AssetBERT (dynamic)",
        "description": "§7.4 grouped eval, finetuned AssetBERT embeddings. 7 dims x {RV,RC}. Binning mode selected at run time via -o override.",
        "template": {
            "model_type": "AssetBERT",
            "embedding_path": [
                "checkpoints/finetune/AssetBERT/d{dim}/2023Q2/AssetBERT_d{dim}_2023Q2_best_embedding.csv",
                "checkpoints/finetune/AssetBERT/d{dim}/2023Q3/AssetBERT_d{dim}_2023Q3_best_embedding.csv",
                "checkpoints/finetune/AssetBERT/d{dim}/2023Q4/AssetBERT_d{dim}_2023Q4_best_embedding.csv",
                "checkpoints/finetune/AssetBERT/d{dim}/2024Q1/AssetBERT_d{dim}_2024Q1_best_embedding.csv",
                "checkpoints/finetune/AssetBERT/d{dim}/2024Q2/AssetBERT_d{dim}_2024Q2_best_embedding.csv",
                "checkpoints/finetune/AssetBERT/d{dim}/2024Q3/AssetBERT_d{dim}_2024Q3_best_embedding.csv"
            ],
            "benchmark_path": [
                "data/processed/Benchmark/2023Q2.csv",
                "data/processed/Benchmark/2023Q3.csv",
                "data/processed/Benchmark/2023Q4.csv",
                "data/processed/Benchmark/2024Q1.csv",
                "data/processed/Benchmark/2024Q2.csv",
                "data/processed/Benchmark/2024Q3.csv"
            ],
            "group_path": [
                "data/processed/ShareHoldingsIntermediate/2023Q2/stock_coverage.csv",
                "data/processed/ShareHoldingsIntermediate/2023Q3/stock_coverage.csv",
                "data/processed/ShareHoldingsIntermediate/2023Q4/stock_coverage.csv",
                "data/processed/ShareHoldingsIntermediate/2024Q1/stock_coverage.csv",
                "data/processed/ShareHoldingsIntermediate/2024Q2/stock_coverage.csv",
                "data/processed/ShareHoldingsIntermediate/2024Q3/stock_coverage.csv"
            ],
            "group_col": "coverage_count",
            "group_stock_col": "Symbol",
            "periods": [
                "2023Q2",
                "2023Q3",
                "2023Q4",
                "2024Q1",
                "2024Q2",
                "2024Q3"
            ],
            "n_quantiles": 4,
            "n_bootstrap": 0,
            "n_permutation": 1000,
            "embedding_token_col": "Token",
            "embedding_value_pattern": "Embed_*",
            "benchmark_stock_col": "Stkcd",
            "normalization": "standard",
            "features": [
                "embedding"
            ],
            "align_chars": false,
            "ridge_alpha": null,
            "winsor_pct": "{winsor_pct}",
            "cv_alpha_min": "{cv_alpha_min}",
            "alpha_scope": "cell",
            "seed": 42
        },
        "output_dir": "configs/coverage/eval/{task}/d{dim}",
        "filename": "AssetBERT_d{dim}.json",
        "variable_params": {
            "dim": [
                4,
                8,
                10,
                16,
                32,
                64,
                128
            ],
            "task": [
                "RV",
                "RC"
            ],
            "winsor_pct": [
                0.1,
                null
            ],
            "cv_alpha_min": [
                1000,
                null
            ]
        },
        "variable_bindings": [
            {
                "task": "RV",
                "winsor_pct": 0.1,
                "cv_alpha_min": 1000
            },
            {
                "task": "RC",
                "winsor_pct": null,
                "cv_alpha_min": null
            }
        ]
    },
