    {
        "name": "Coverage groups - characteristics baseline",
        "description": "§7.4 per-group four/six-characteristic baseline (features: chars only). Model- and dim-independent; groups come from group_path. One config per task. Own caliber (the char subsamples are far smaller than the embedding samples and the design matrix is 4-6 columns, not 128): RV fixes the ridge penalty at 700 and winsorizes the residual target at the conventional 1% (largest penalty-relaxation that keeps every embedding model above the char row in every group); RC winsorizes the heavy-tailed return target at 0.5% and selects the CV penalty once on the period's whole cross section (alpha_scope=cross_section).",
        "template": {
            "model_type": "Chars",
            "embedding_path": null,
            "benchmark_path": [
                "data/processed/Benchmark/2023Q2.csv",
                "data/processed/Benchmark/2023Q3.csv",
                "data/processed/Benchmark/2023Q4.csv",
                "data/processed/Benchmark/2024Q1.csv",
                "data/processed/Benchmark/2024Q2.csv",
                "data/processed/Benchmark/2024Q3.csv"
            ],
            "group_path": [
                "data/processed/ShareHoldingsIntermediate/2023Q2/stock_coverage.csv",
                "data/processed/ShareHoldingsIntermediate/2023Q3/stock_coverage.csv",
                "data/processed/ShareHoldingsIntermediate/2023Q4/stock_coverage.csv",
                "data/processed/ShareHoldingsIntermediate/2024Q1/stock_coverage.csv",
                "data/processed/ShareHoldingsIntermediate/2024Q2/stock_coverage.csv",
                "data/processed/ShareHoldingsIntermediate/2024Q3/stock_coverage.csv"
            ],
            "group_col": "coverage_count",
            "group_stock_col": "Symbol",
            "periods": [
                "2023Q2",
                "2023Q3",
                "2023Q4",
                "2024Q1",
                "2024Q2",
                "2024Q3"
            ],
            "n_quantiles": 4,
            "n_bootstrap": 0,
            "n_permutation": 1000,
            "embedding_token_col": "Token",
            "embedding_value_pattern": "Embed_*",
            "benchmark_stock_col": "Stkcd",
            "normalization": "standard",
            "features": [
                "chars"
            ],
            "align_chars": false,
            "ridge_alpha": "{ridge_alpha}",
            "winsor_pct": "{winsor_pct}",
            "cv_alpha_min": null,
            "alpha_scope": "{alpha_scope}",
            "seed": 42
        },
        "output_dir": "configs/coverage/eval/{task}/char",
        "filename": "char_baseline.json",
        "variable_params": {
            "task": [
                "RV",
                "RC"
            ],
            "ridge_alpha": [
