[
    {
        "name": "RV - Embedding models (CBOW)",
        "description": "RV evaluation for CBOW embedding models (W2V_cbow/BERT_cbow). 2 models × 7 dims × 2 variants (plain/+Chars) = 28 configs. (CBOW variant)",
        "template": {
            "model_type": "{model_type}",
            "embedding_path": [
                "checkpoints/w2v_model_ablation/finetune/{model_path}/d{dim}/2023Q2/{model_type}_d{dim}_2023Q2{_add_best}_embedding.csv",
                "checkpoints/w2v_model_ablation/finetune/{model_path}/d{dim}/2023Q3/{model_type}_d{dim}_2023Q3{_add_best}_embedding.csv",
                "checkpoints/w2v_model_ablation/finetune/{model_path}/d{dim}/2023Q4/{model_type}_d{dim}_2023Q4{_add_best}_embedding.csv",
                "checkpoints/w2v_model_ablation/finetune/{model_path}/d{dim}/2024Q1/{model_type}_d{dim}_2024Q1{_add_best}_embedding.csv",
                "checkpoints/w2v_model_ablation/finetune/{model_path}/d{dim}/2024Q2/{model_type}_d{dim}_2024Q2{_add_best}_embedding.csv",
                "checkpoints/w2v_model_ablation/finetune/{model_path}/d{dim}/2024Q3/{model_type}_d{dim}_2024Q3{_add_best}_embedding.csv"
            ],
            "benchmark_path": [
                "data/processed/Benchmark/2023Q2.csv",
                "data/processed/Benchmark/2023Q3.csv",
                "data/processed/Benchmark/2023Q4.csv",
                "data/processed/Benchmark/2024Q1.csv",
                "data/processed/Benchmark/2024Q2.csv",
                "data/processed/Benchmark/2024Q3.csv"
            ],
            "periods": [
                "2023Q2",
                "2023Q3",
                "2023Q4",
                "2024Q1",
                "2024Q2",
                "2024Q3"
            ],
            "embedding_token_col": "Token",
            "embedding_value_pattern": "Embed_*",
            "benchmark_stock_col": "Stkcd",
            "normalization": "standard",
            "features": "{features}",
            "align_chars": true,
            "ridge_alpha": 0.5,
            "seed": 42
        },
        "output_dir": "configs/w2v_model_ablation/eval/RV/d{dim}",
        "filename": "{model_type}_d{dim}{_addChars}.json",
        "variable_params": {
            "dim": [
                4,
                8,
                10,
                16,
                32,
                64,
                128
            ],
            "model_type": [
                "AssetW2V_cbow",
                "AssetBERT_cbow"
            ],
            "model_path": [
                "AssetW2V_cbow",
                "AssetBERT_cbow"
            ],
            "_addChars": [
                "",
                "_addChars"
            ],
            "_add_best": [
                "",
                "_best"
            ],
            "features": [
                [
                    "embedding"
                ],
                [
                    "embedding",
                    "chars"
                ]
            ]
        },
        "variable_bindings": [
            {
                "model_type": "AssetW2V_cbow",
                "model_path": "AssetW2V_cbow",
                "_add_best": ""
            },
            {
                "model_type": "AssetBERT_cbow",
                "model_path": "AssetBERT_cbow",
                "_add_best": "_best"
            },
            {
                "_addChars": "",
                "features": [
                    "embedding"
                ]
            },
            {
                "_addChars": "_addChars",
                "features": [
                    "embedding",
                    "chars"
                ]
            }
        ]
    },
