[
    {
        "name": "MP RandomEncoder TimeSplit - AssetBERT",
        "description": "MP evaluation for AssetBERT with random-init BERT encoder on 50/50 time-split. 1 model × 7 dims × 16 quarters = 112 configs.",
        "template": {
            "run": {
                "period": "{quarter}"
            },
            "model": {
                "model_type": "BERT",
                "model_checkpoint": null,
                "embedding_file": "checkpoints/timesplit_robust/finetune/{model}/d{dim}/{quarter}/{model}_d{dim}_{quarter}_best_embedding.csv",
                "vocab_size": 5093,
                "hidden_size": "{dim}",
                "num_hidden_layers": 4,
                "num_attention_heads": 2,
                "intermediate_size": 512,
                "max_position_embeddings": 256,
                "type_vocab_size": 1,
                "freeze_embedding": true,
                "freeze_encoder": false,
                "embedding_model": "{model}"
            },
            "tokenizer": {
                "w2v_model": null,
                "embedding_file": "checkpoints/timesplit_robust/finetune/{model}/d{dim}/{quarter}/{model}_d{dim}_{quarter}_best_embedding.csv",
                "vocab_file": null,
                "pretrained_tokenizer_file": null,
                "alias_file": null
            },
            "dataset": {
                "data_path": "data/processed/MutualFundShareHoldings_TimeSplit/finetune/{quarter}.csv",
                "data_format": "csv",
                "id_key": "InvestorID",
                "portfolio_key": "Portfolio",
                "proportion1_key": "Proportion1",
                "proportion2_key": "Proportion2",
                "include_proportion": true,
                "max_length": 256,
                "mask_prob": null,
                "mask_indices": [
                    2
                ]
            },
            "dataloader": {
                "batch_size": 32,
                "shuffle": true,
                "num_workers": 4,
                "pin_memory": true,
                "drop_last": false
            },
            "optimizer": {
                "optimizer_type": "PagedAdam8bit",
                "optimizer_kwargs": null,
                "learning_rate": 0.001,
                "lr_scheduler_type": "cosine",
                "lr_scheduler_warmup_steps": 100,
                "lr_scheduler_train_steps": null,
                "lr_scheduler_num_cycles": 0.5,
                "lr_scheduler_power": 0
            },
            "accelerator": {
                "mixed_precision": "auto",
                "gradient_accumulation_steps": 1,
                "accelerator_checkpoint": null,
                "use_compile": true,
                "compile_backend": "inductor",
                "compile_mode": "default",
                "compile_fullgraph": false,
                "compile_dynamic": false,
                "compile_cache_dir": null,
                "allow_tf32": true
            },
            "train": {
                "max_epochs": 30,
                "validation_split": 0.2,
                "test_split": 0.1,
                "split_method": "random",
                "best_metric": "val_loss",
                "clip_grad_norm": 1.0,
                "clip_grad_value": null,
                "detect_anomaly": false,
                "log_every_steps": 200,
                "report_every_epochs": 1,
                "save_every_epochs": 1,
                "save_folder": "checkpoints/mp_bert_random_encoder_timesplit/refine/BERT/{model}/d{dim}/{quarter}",
                "save_name": "{model}_d{dim}_{quarter}",
                "save_format": ".safetensors",
                "seed": 42
            }
        },
        "output_dir": "configs/mp_bert_random_encoder_timesplit/eval/MP/BERT/{model}/d{dim}",
        "filename": "{model}_d{dim}_{quarter}.json",
        "variable_params": {
            "model": [
                "AssetBERT"
            ],
            "dim": [
                4,
                8,
                10,
                16,
                32,
                64,
                128
            ],
            "quarter": [
                "2020Q4",
                "2021Q1",
                "2021Q2",
                "2021Q3",
                "2021Q4",
                "2022Q1",
                "2022Q2",
                "2022Q3",
                "2022Q4",
                "2023Q1",
                "2023Q2",
                "2023Q3",
                "2023Q4",
                "2024Q1",
                "2024Q2",
                "2024Q3"
            ]
        },
        "variable_bindings": null
    }
]
